    "8A12EBE045C80892F4770A9ECBB4BC1E": "Kılıç",
    "F79A37864CC0BFFA1E59DC92EB0C81AC": "Kılıç",
    "01425AA2473AFD22BD25ABBA71671F08": "En büyük düşmanlarına toz yuttur!",
