  "Juno_UpdateItemData": {
    "E71B148345D9F51ABA60BAA7715FFF8C": "Zwykła siekiera. Doskonale nadaje się do zbierania drewna – albo do obrony.",
    "BA8A97B44554B405C3A3F589679371F4": "Zwykła kusza. Idealna do atakowania wrogów z daleka.",
    "F2B00A754BA6DB6038B685849C458166": "Zwykły sztylet. Doskonały do walki w zwarciu. Uderzenie celu od tyłu powoduje trafienie krytyczne.",
    "B2EC4D584DBD7E09FE9275951C278DE3": "Zwykła maczeta. Bardzo ułatwia przebijanie się przez krzaki i niebezpieczne rośliny.",
    "A8326CBC4CFE55AF8F1520AA392EC068": "Zwykły kilof. Umożliwia pozyskiwanie kamienia i jest bardzo skuteczny przeciw budowlom.",
    "2FF7A658432E7F0F2F32F69C2A39E26D": "Zwykła włócznia, służąca do walki z bliska lub na dystans. Dotknij, by zaatakować. Przytrzymaj, by rzucić.",
    "AE563B2F43613D7F0AECB292B64B73DF": "Zwykły miecz. Idealny do walki wręcz.",
    "7CF409744D7B83E5180CBE80AFAF26F6": "Legendarny sztylet. Przeniesiony z innego wymiaru. Doskonały do walki w zwarciu. Uderzenie celu od tyłu powoduje trafienie krytyczne.",
    "58CCDEDB45508E84C21C6FB0E0B0A67D": "Legendarna maczeta. Miejsce pochodzenia: inny wymiar. Bardzo ułatwia przebijanie się przez krzaki i niebezpieczne rośliny.",
    "C9B55874497611D1854DACA09C73D7A8": "Legendarna włócznia. Przeniesiona z innego wymiaru do walki z bliska lub na dystans. Dotknij, by zaatakować. Przytrzymaj, by rzucić.",
    "B6B759B749F487113D1AE2B86704881B": "Rzadka siekiera. Doskonale nadaje się do zbierania drewna – albo do obrony.",
    "029E013E4374878AB9BFE19ADA948E3E": "Rzadka kusza. Idealna do atakowania wrogów z daleka.",
    "BF8D56464E050C1E72C7CEBC9A3EA194": "Rzadki sztylet. Doskonały do walki w zwarciu. Uderzenie celu od tyłu powoduje trafienie krytyczne.",
    "1EC2DDF44E5160BAA349EBBD8B821F4B": "Rzadka maczeta. Bardzo ułatwia przebijanie się przez krzaki i niebezpieczne rośliny.",
    "A72F283A42A9AA13FF28F9BE9DC45306": "Rzadki kilof. Umożliwia pozyskiwanie kamienia i jest bardzo skuteczny przeciw budowlom.",
    "C97DE30E40705C344BE07F9596A14154": "Rzadka włócznia, służąca do walki z bliska lub na dystans. Dotknij, by zaatakować. Przytrzymaj, by rzucić.",
    "D9106AC141FE5082CEB5F4B2D82CF3EE": "Rzadki miecz. Idealny do walki wręcz.",
    "FD2D6B974FCBE809731AF6893DBE3D3C": "Idealny do ataków z zaskoczenia.",
    "19EB3A8A4E2D9FB290BCF4839FFA2C74": "Epicka siekiera. Doskonale nadaje się do zbierania drewna – albo do obrony.",
    "E574BE2941B2D97FE3CD2AB061AB9E81": "Epicka kusza. Idealna do atakowania wrogów z daleka.",
    "FC6EBECF4519B5AFD680AABB4F6FB735": "Epicki sztylet. Doskonały do walki w zwarciu. Uderzenie celu od tyłu powoduje trafienie krytyczne.",
    "A85F794D4CF3981BA8C8F6817660DD65": "Epicka maczeta. Bardzo ułatwia przebijanie się przez krzaki i niebezpieczne rośliny.",
    "D98FE59C4C19A3A91CABD2986BA88144": "Epicki kilof. Umożliwia pozyskiwanie kamienia i jest bardzo skuteczny przeciw budowlom.",
    "61EFFEFF4C236BA0CF611C85D501BD47": "Epicka włócznia, służąca do walki z bliska lub na dystans. Dotknij, by zaatakować. Przytrzymaj, by rzucić.",
    "5F11718A4E6B321D22120BB2A6B8A4DC": "Epicki miecz. Idealny do walki wręcz.",
    "8CA9523B46BEDECFC7C2A4A397FAD105": "Niepospolita siekiera. Doskonale nadaje się do zbierania drewna – albo do obrony.",
    "A33B4B924F122089213E94AD7A953786": "Niepospolita kusza. Idealna do atakowania wrogów z daleka.",
    "ECA675C341AC24F83A403496A3EB8D1C": "Niepospolity sztylet. Doskonały do walki w zwarciu. Uderzenie celu od tyłu powoduje trafienie krytyczne.",
    "6BF5E8A4419DE2DB3D3B629CBFAF756D": "Niepospolita maczeta. Bardzo ułatwia przebijanie się przez krzaki i niebezpieczne rośliny.",
    "10712A5E4A448BAFE1E9D79EA4DF483C": "Niepospolity kilof. Umożliwia pozyskiwanie kamienia i jest bardzo skuteczny przeciw budowlom.",
    "37E4DE51440F850817BD198B9794893C": "Niepospolita włócznia, służąca do walki z bliska lub na dystans. Dotknij, by zaatakować. Przytrzymaj, by rzucić.",
    "AF5B3EC64C4798D12554768027DCE3EC": "Niepospolity miecz. Idealny do walki wręcz.",
    "F1C4DBB3441BEDEADC659FBA8F88B84A": "Służy też do smarowania chleba masłem!",
    "1856A4A44007F5A4DEB6A1AF67BDBE5A": "Siekiera",
    "20EDC3C645BE8D1310A7D0947D524422": "Siekiera",
    "382DEEE046C89638DA61C99219C7F129": "Siekiera",
    "D036AE7740FC4546A37D5C9F95DA5EBA": "Siekiera",
    "9B78156D41D566275205128A5B0CA254": "Rach-ciach-ciach!",
    "3C676F0E428908174B44A89D34F13FF3": "Kusza",
    "3C97692F47503C312A86A0995145B1C7": "Kusza",
    "7B41CBD14A32A3F6CC6C28A6CB5E3A1F": "Kusza",
    "CC80C6564E44FE6A3DC0C7A53004795F": "Kusza",
    "28740A3A4F2D02FBEC8F09B38C2AE715": "Sztylet",
    "2EFF98ED4FFCD3533683F89E5D745250": "Sztylet",
    "99DB6501412A41675F792385624ADE10": "Sztylet",
    "A0C7C4FF40BB75B61D87299FFC4CA702": "Sztylet",
    "FD3A3071460AE40E7F7CBEB1EAE03113": "Sztylet",
    "7DB8FA604B1CA5C2F0A44DAA3E9A3AE2": "Wal wprost do celu.",
    "F4CD198D419A669F1ACB1590CDBA88E8": "Wejdź w bliski kontakt.",
    "1442DCF142043A1BADA6F4A7AD5A608D": "Jeśli stoi ci na drodze, możesz to wyrwać.",
    "51ECA5C14B6E8F54B5304BB5ADBDA937": "Niech polecą bełty!",
    "0E27EE0C4C0CE61F8BB5A78EF1222B4F": "Maczeta",
    "5EC540014509E02343B6DA9D72E9B1C5": "Maczeta",
    "AEDE51C94D70FC5FB0A1A49B4ACD07B5": "Maczeta",
    "C09284EB4237AB7C6BD6DAA26EB82FB9": "Maczeta",
    "D95B3740471FDBC3494B8FBC6237506F": "Maczeta",
    "CB2860C44ABA591BBB8EFDBB570437A7": "Ta siekiera z pewnością obali drzewa i różnych przeciwników.",
    "73CDC8624D83E583BE6DD0907F5B0BA1": "Wyraź swoje zdanie na odległość.",
    "B936B9374E2A0F27E192DDB19FDBF9BE": "Dobrze wyceluj i powal kilku wrogów.",
    "07B4CD914663EEBB03653CB46F299794": "Kilof",
    "10A3F1D742715B58290F30B070085BE7": "Kilof",
    "BA50FD484FBD92708360C6ACFF6F56D9": "Kilof",
    "EBBD2A0549A1997B9B69F893795B2F9F": "Kilof",
    "C6B19F464DCBBCB4D07EDCBABAFB9BCE": "Tnij i siecz!",
    "15CF947D482BB234135301ADAA7D17ED": "Włócznia",
    "98CB07F948C994A99B8014ABF78E1FFE": "Włócznia",
    "AB1006D04BB9A54F686B65A4233C68B6": "Włócznia",
    "D4C8D1F8421154E5608889A704C75209": "Włócznia",
    "FC19C7D24DA832851A6329A0260E31A4": "Włócznia",
    "D4FF08AF43B556FED9939584961BCEE1": "To ciężki kilof do wydobywania ciężkich metali.",
    "BD75370244C7062E54C0209895D54EFA": "Wystarczająco silna, by ścinać drzewa i głowy twoich wrogów.",
    "57BAE3A44D58AE71C524CA88BE2D44E5": "Miecz",
    "64FF41B94261B0FB7AD1718EC26C09F9": "Miecz",
    "8A12EBE045C80892F4770A9ECBB4BC1E": "Miecz",
    "F79A37864CC0BFFA1E59DC92EB0C81AC": "Miecz",
    "01425AA2473AFD22BD25ABBA71671F08": "Pokonasz nim najpotężniejszych przeciwników!",
    "6785200B467D3AC85D22899768AF4A6D": "Broń do walki z groźniejszymi wrogami.",
    "951808D14B22DC43EA0B1FA42F199CA5": "Pora pokazać tym drzewom, kto tu rządzi.",
    "32FA1E084CE463DB1A89509F8196A913": "Najlepszy sztylet.",
    "EC74A49744BF5644982B2792E16C9CC0": "Najlepsza włócznia.",
    "F08B75B649CBDE2DCB5EB5A2CF69B966": "Niech lepiej pilnują pleców.",
    "1932873F4095A8E4223BA8B64FDBC0D8": "Nigdy nie wpadną na to, co ich trafiło.",
    "ED65BC4D4AAC403CF097D28227570FEC": "Te skały nie mają żadnych szans.",
    "FF54A7924848FE0FD95761AB0B412026": "Obróć głazy w drobne kamyczki.",
    "95C2440A4965F62CC98FB08F6F853BB2": "Nie służy do włóczenia się.",
    "D43BAD9A494E139567F0838497C1AF84": "Rzuca się w oczy.",
    "C83CBD4C48D1362FB36BACA90735B74F": "Rzuca się w oczy. Bardzo.",
    "EC5C350A41F0A4104685378574D2B72E": "Rzuca się w oczy. NAJBARDZIEJ!"
  }
