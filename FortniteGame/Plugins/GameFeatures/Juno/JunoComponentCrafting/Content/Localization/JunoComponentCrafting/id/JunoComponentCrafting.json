    "D4C8D1F8421154E5608889A704C75209": "Tombak",
    "FC19C7D24DA832851A6329A0260E31A4": "Tombak",
    "D4FF08AF43B556FED9939584961BCEE1": "Pecahkan logam berat dengan Beliung berat ini.",
    "BD75370244C7062E54C0209895D54EFA": "Cukup kuat untuk menebang pohon ... atau musuhmu.",
    "57BAE3A44D58AE71C524CA88BE2D44E5": "Pedang",
    "64FF41B94261B0FB7AD1718EC26C09F9": "Pedang",
    "8A12EBE045C80892F4770A9ECBB4BC1E": "Pedang",
    "F79A37864CC0BFFA1E59DC92EB0C81AC": "Pedang",
    "01425AA2473AFD22BD25ABBA71671F08": "Kalahkan lawan terberatmu!",
    "6785200B467D3AC85D22899768AF4A6D": "Hadapi musuh yang lebih kuat.",
    "951808D14B22DC43EA0B1FA42F199CA5": "Tebang pohon sedikit demi sedikit.",
    "32FA1E084CE463DB1A89509F8196A913": "Belati pamungkas.",
    "EC74A49744BF5644982B2792E16C9CC0": "Tombak pemungkas.",
    "F08B75B649CBDE2DCB5EB5A2CF69B966": "Mereka harus berhati-hati.",
