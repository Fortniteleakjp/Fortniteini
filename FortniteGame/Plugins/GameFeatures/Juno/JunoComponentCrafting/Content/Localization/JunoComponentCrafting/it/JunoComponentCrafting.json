    "98CB07F948C994A99B8014ABF78E1FFE": "Lancia",
    "AB1006D04BB9A54F686B65A4233C68B6": "Lancia",
    "D4C8D1F8421154E5608889A704C75209": "Lancia",
    "FC19C7D24DA832851A6329A0260E31A4": "Lancia",
    "D4FF08AF43B556FED9939584961BCEE1": "Un piccone pesante per metalli pesanti.",
    "BD75370244C7062E54C0209895D54EFA": "Abbastanza robusta da abbattere gli alberi... o i tuoi nemici.",
    "57BAE3A44D58AE71C524CA88BE2D44E5": "Spada",
    "64FF41B94261B0FB7AD1718EC26C09F9": "Spada",
    "8A12EBE045C80892F4770A9ECBB4BC1E": "Spada",
    "F79A37864CC0BFFA1E59DC92EB0C81AC": "Spada",
    "01425AA2473AFD22BD25ABBA71671F08": "Abbatti i tuoi nemici peggiori!",
    "6785200B467D3AC85D22899768AF4A6D": "Affronta nemici più forti.",
    "951808D14B22DC43EA0B1FA42F199CA5": "Dai un taglio alle ambizioni di alcuni alberi.",
    "32FA1E084CE463DB1A89509F8196A913": "Il pugnale definitivo.",
    "EC74A49744BF5644982B2792E16C9CC0": "La lancia definitiva.",
    "F08B75B649CBDE2DCB5EB5A2CF69B966": "Farebbero meglio a guardarsi le spalle.",
    "1932873F4095A8E4223BA8B64FDBC0D8": "Non se l'aspetteranno mai.",
    "ED65BC4D4AAC403CF097D28227570FEC": "Quelle rocce non hanno speranze.",
    "FF54A7924848FE0FD95761AB0B412026": "Trasforma le rocce in piccoli ciottoli.",
    "95C2440A4965F62CC98FB08F6F853BB2": "Va dritta al punto.",
    "D43BAD9A494E139567F0838497C1AF84": "Va dritta al punto e ha uno spirito pungente.",
    "C83CBD4C48D1362FB36BACA90735B74F": "Va dritta al punto e ha uno spirito davvero pungente.",
    "EC5C350A41F0A4104685378574D2B72E": "Non ho mai visto nulla che andasse così dritto al punto."
