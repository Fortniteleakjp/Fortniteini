    "5EC540014509E02343B6DA9D72E9B1C5": "Machete",
    "AEDE51C94D70FC5FB0A1A49B4ACD07B5": "Machete",
    "C09284EB4237AB7C6BD6DAA26EB82FB9": "Machete",
    "D95B3740471FDBC3494B8FBC6237506F": "Machete",
    "CB2860C44ABA591BBB8EFDBB570437A7": "Abbatti un paio di alberi e ancora più nemici con una di queste.",
    "73CDC8624D83E583BE6DD0907F5B0BA1": "Arriva al punto da grandi distanze.",
    "B936B9374E2A0F27E192DDB19FDBF9BE": "Incocca le frecce e stendi i nemici.",
    "07B4CD914663EEBB03653CB46F299794": "Piccone",
